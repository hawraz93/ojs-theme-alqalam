msgstr "Received"

msgid "plugins.themes.alqalam.share.title"
msgstr "Share this article"

msgid "plugins.themes.alqalam.share.copyLink"
msgstr "Copy link"

msgid "plugins.themes.alqalam.share.copied"
msgstr "Link copied"

msgid "plugins.themes.alqalam.share.email"
msgstr "Share by e-mail"

